rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasAccountType(accountType) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && currentUser().data.accountType == accountType;
    }

    function isRescueUser() {
      return hasAccountType('rescue') || hasAccountType('rescue_admin');
    }

    function chatParticipant() {
      return signedIn()
        && (resource.data.primaryUserId == request.auth.uid
          || resource.data.secondaryUserId == request.auth.uid);
    }

    function requestedChatParticipant() {
      return signedIn()
        && (request.resource.data.primaryUserId == request.auth.uid
          || request.resource.data.secondaryUserId == request.auth.uid);
    }

    match /users/{document} {
      allow create: if isOwner(document);
      allow read: if isOwner(document)
        || (signedIn() && resource.data.accountType in ['rescue', 'rescue_admin']);
      allow update: if isOwner(document);
      allow delete: if false;
    }

    match /dogs/{document} {
      allow create: if isRescueUser()
        && (request.resource.data.organizationID == request.auth.uid
          || request.resource.data.uid == request.auth.uid);
      allow read: if resource.data.visibility == 'public'
        || resource.data.visibility == 'rescue'
        || signedIn();
      allow update: if signedIn()
        && (resource.data.organizationID == request.auth.uid
          || resource.data.uid == request.auth.uid
          || isRescueUser());
      allow delete: if signedIn()
        && (resource.data.organizationID == request.auth.uid
          || resource.data.uid == request.auth.uid);
    }

    match /Chat/{document} {
      allow create: if requestedChatParticipant();
      allow read: if chatParticipant();
      allow write: if false;
      allow delete: if false;
    }

    match /Chat/{parent}/Message/{document} {
      allow create: if signedIn()
        && (get(/databases/$(database)/documents/Chat/$(parent)).data.primaryUserId == request.auth.uid
          || get(/databases/$(database)/documents/Chat/$(parent)).data.secondaryUserId == request.auth.uid);
      allow read: if signedIn()
        && (get(/databases/$(database)/documents/Chat/$(parent)).data.primaryUserId == request.auth.uid
          || get(/databases/$(database)/documents/Chat/$(parent)).data.secondaryUserId == request.auth.uid);
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/Message/{document} {
      allow read: if false;
    }

  }
}
